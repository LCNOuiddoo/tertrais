<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_inherit_title" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.title</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]/group[1]" position="inside">
                <field name="title" no-create="1" no-open="1" placeholder="e.g. Mister"/>
            </xpath>
        </field>
    </record>
</odoo>
