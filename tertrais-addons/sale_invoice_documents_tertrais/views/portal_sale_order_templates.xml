<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customize sale order portal page -->
    <template id="portal_my_orders_custom" inherit_id="sale.portal_my_orders">
        <!-- No modifications needed for the orders list page -->
    </template>

    <template id="sale_order_portal_content_custom" inherit_id="sale.sale_order_portal_content">
        
        <!-- Rename "Unit Price" to "P.U HT" -->
        <xpath expr="//th[@id='product_unit_price_header']" position="replace">
            <th t-attf-class="text-end {{ 'd-none d-sm-table-cell' if report_type == 'html' else '' }}" id="product_unit_price_header">
                P.U HT
            </th>
        </xpath>
        
        <!-- Rename "Taxes" to "TVA" -->
        <xpath expr="//th[@id='taxes_header']/span" position="replace">
            <span>TVA</span>
        </xpath>
        
        <!-- Add new column header "P.U TTC" after taxes column -->
        <xpath expr="//th[@id='taxes_header']" position="after">
            <th t-if="display_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" id="priceunit_ttc_header">
                <span>P.U TTC</span>
            </th>
        </xpath>
        
        <!-- Rename "Amount" to "Total TTC" -->
        <xpath expr="//th[@id='subtotal_header']/span" position="replace">
            <span>Total TTC</span>
        </xpath>
        
        <!-- Force price_field to always be 'price_total' for TTC display -->
        <xpath expr="//t[@t-set='price_field']" position="replace">
            <t t-set="price_field" t-value="'price_total'"/>
        </xpath>

        <!-- Remove the conditional price_total span since we always show it now -->
        <xpath expr="//span[@t-field='line.price_total']" position="replace"/>
        
        <!-- Force display of price_total in the Total TTC column -->
        <xpath expr="//span[@t-field='line.price_subtotal']" position="replace">
            <span t-field="line.price_total">27.00</span>
        </xpath>
        
        <!-- Add P.U TTC cell for regular product lines -->
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_taxes']" position="after">
            <td t-if="display_taxes" name="td_product_priceunit_ttc" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <t t-if="not collapse_prices and line.product_uom_qty">
                    <span 
                        t-out="line.price_total / line.product_uom_qty"
                        t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id}"
                    />
                </t>
            </td>
        </xpath>
        
        <!-- Add P.U TTC cell for grouped section lines -->
        <xpath expr="//tr[@name='tr_section_group']/td[@name='td_section_group_taxes']" position="after">
            <td t-if="display_taxes" name="td_section_group_priceunit_ttc" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <!-- Empty cell for grouped sections -->
            </td>
        </xpath>
        
        <!-- Force section grouped totals to display price_total -->
        <xpath expr="//td[@name='td_section_group_total']/span[@name='price_subtotal_section_grouped']" position="attributes">
            <attribute name="t-out">section_line['price_total']</attribute>
        </xpath>
        
        <!-- Update colspan for section headers to account for new column -->
        <xpath expr="//tr[@name='tr_section']/td[@name='td_section_name']" position="attributes">
            <attribute name="t-att-colspan">3 + (1 if display_discount else 0) + (2 if display_taxes else 0)</attribute>
        </xpath>
        
    </template>
</odoo>
